---
import "../styles/global.css";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import profilePicture from "../assets/profile-picture.png";
import LinkedIn from "../icons/linkedin.svg";
import X from "../icons/x.svg";
import GitHub from "../icons/github.svg";
import Figma from "../icons/figma.svg";

const ctaLabel = "Book a call";
const icons ={ linkedin: LinkedIn, x: X, github: GitHub, figma: Figma };
const socials = (await getCollection("social")).sort((a, b) => a.data.order - b.data.order);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro</title>
  </head>
  <body>
    <main>
      <section>
        <Image class="profile-picture" src={profilePicture} alt="Shinji Pons" width={160} height={160} />
        <p>
          <strong>Shinji Pons</strong><br />
          Software designer<br />
          <span class="available">Available</span>
        </p>
      </section>

      <section>
        <p>
          My expertise lies in the design of 3D tools and workflows for creative
          professionals. Right now, I'm taking my time to look for my next role.
        </p>
        <div>
          <p>Get in touch if</p>
          <ul>
            <li>you are building software that helps other make things</li>
            <li>deeply care about human creativity, design and quality</li>
          </ul>
        </div>
      </section>

      <section class="cta">
        <a class="button" href="https://cal.com/shinjipons/" target="_blank" aria-label={ctaLabel}>
          <span class="rolling-text" aria-hidden="true">
            <span class="rolling-copy">{[...ctaLabel].map((char) => <span>{char}</span>)}</span>
            <span class="rolling-copy">{[...ctaLabel].map((char) => <span>{char}</span>)}</span>
          </span>
        </a>
        {socials.map(({ id, data }) => {
          const Icon = icons[id];
          return (
            <a class="social-link" href={data.url} target="_blank" aria-label={data.name} data-social={id}>
              <Icon />
            </a>
          );
        })}
        <div class="hover-card">
          <div class="hover-card-header">
            <Image class="avatar" src={profilePicture} alt="Shinji Pons" width={96} height={96} />
            <a class="button follow-button" href="https://x.com/intent/follow?screen_name=shinjipons" target="_blank">Follow</a>
          </div>
          <p><strong>Shinji Pons</strong><br />@shinjipons</p>
          <p><strong>358</strong> following&nbsp;&nbsp;<strong>133</strong> followers</p>
        </div>
      </section>
    </main>

    <script>
      import { animate, hover, stagger } from "motion";

      hover(".button", (button) => {
        const copies = button.querySelectorAll(".rolling-copy");
        copies.forEach((copy) => animate(copy.querySelectorAll("span"), { y: "-100%" }, { delay: stagger(0.02) }));
        return () => copies.forEach((copy) => animate(copy.querySelectorAll("span"), { y: 0 }, { delay: stagger(0.02) }));
      });

      const card = document.querySelector(".hover-card");
      let hideTimer;

      hover([document.querySelector('[data-social="x"]'), card], () => {
        clearTimeout(hideTimer);
        card.style.pointerEvents = "auto";
        animate(card, { opacity: 1, y: 0 }, { duration: 0.2 });
        return () => {
          hideTimer = setTimeout(() => {
            card.style.pointerEvents = "none";
            animate(card, { opacity: 0, y: -8 }, { duration: 0.2 });
          }, 150);
        };
      });
    </script>
  </body>
</html>
