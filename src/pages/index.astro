---
import "../styles/global.css";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import profilePicture from "../assets/profile-picture.png";
import LinkedIn from "../icons/linkedin.svg";
import X from "../icons/x.svg";
import GitHub from "../icons/github.svg";
import Figma from "../icons/figma.svg";

const ctaLabel = "Book a call";
const icons ={ linkedin: LinkedIn, x: X, github: GitHub, figma: Figma };
const socials = (await getCollection("social")).sort((a, b) => a.data.order - b.data.order);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro</title>
  </head>
  <body>
    <main>
      <section>
        <Image class="profile-picture" src={profilePicture} alt="Shinji Pons" width={160} height={160} />
        <p>
          <strong>Shinji Pons</strong><br />
          Software designer<br />
          <span class="available">Available</span>
        </p>
      </section>

      <section>
        <p>
          My expertise lies in the design of 3D tools and workflows for creative
          professionals. Right now, I'm taking my time to look for my next role.
        </p>
        <div>
          <p>Get in touch if</p>
          <ul>
            <li>you are building software that helps other make things</li>
            <li>deeply care about human creativity, design and quality</li>
          </ul>
        </div>
      </section>

      <section class="cta">
        <a class="button" href="https://cal.com/shinjipons/" target="_blank" aria-label={ctaLabel}>
          <span class="rolling-text" aria-hidden="true">
            <span class="rolling-copy">{[...ctaLabel].map((char) => <span>{char}</span>)}</span>
            <span class="rolling-copy">{[...ctaLabel].map((char) => <span>{char}</span>)}</span>
          </span>
        </a>
        {socials.map(({ id, data }) => {
          const Icon = icons[id];
          return (
            <a class="social-link" href={data.url} target="_blank" aria-label={data.name} data-social={id}>
              <Icon />
            </a>
          );
        })}
        <div class="hover-card" data-for="x">
          <div class="hover-card-header">
            <Image class="avatar" src={profilePicture} alt="Shinji Pons" width={96} height={96} />
            <a class="button follow-button" href="https://x.com/intent/follow?screen_name=shinjipons" target="_blank">Follow</a>
          </div>
          <p><strong>Shinji Pons</strong><br />@shinjipons</p>
          <p><strong>358</strong> following&nbsp;&nbsp;<strong>133</strong> followers</p>
        </div>
        <div class="hover-card" data-for="linkedin">
          <div class="hover-card-header">
            <Image class="avatar" src={profilePicture} alt="Shinji Pons" width={96} height={96} />
            <a class="button follow-button" href="https://www.linkedin.com/in/shinjipons" target="_blank">Connect</a>
          </div>
          <p><strong>Shinji Pons</strong><br />I design 3D tools and workflows</p>
          <p><strong>312</strong> connections</p>
        </div>
        <div class="hover-card" data-for="github">
          <div class="hover-card-header">
            <Image class="avatar" src={profilePicture} alt="Shinji Pons" width={96} height={96} />
            <a class="button follow-button" href="https://github.com/shinjipons/" target="_blank">Follow</a>
          </div>
          <p><strong>Shinji Pons</strong><br />@shinjipons</p>
          <p><strong>7</strong> repositories</p>
        </div>
      </section>
    </main>

    <script>
      import { animate, hover, stagger } from "motion";

      hover(".button", (button) => {
        const copies = button.querySelectorAll(".rolling-copy");
        copies.forEach((copy) => animate(copy.querySelectorAll("span"), { y: "-100%" }, { delay: stagger(0.02) }));
        return () => copies.forEach((copy) => animate(copy.querySelectorAll("span"), { y: 0 }, { delay: stagger(0.02) }));
      });

      // The card currently showing, so moving to another icon can crossfade cards in place
      let openCard = null;

      // Crossfade: only opacity animates; the card jumps straight to its position
      const fadeIn = { duration: 0.1, y: { duration: 0 } };
      const fadeOut = { duration: 0.1, y: { delay: 0.1, duration: 0 } };

      document.querySelectorAll(".hover-card").forEach((card) => {
        let hideTimer;

        const show = (transition) => {
          card.style.pointerEvents = "auto";
          animate(card, { opacity: 1, y: 0 }, transition);
          openCard = { card, close };
        };
        const hide = (transition) => {
          card.style.pointerEvents = "none";
          animate(card, { opacity: 0, y: -8 }, transition);
          if (openCard?.card === card) openCard = null;
        };
        const close = () => {
          clearTimeout(hideTimer);
          hide(fadeOut);
        };

        hover([document.querySelector(`[data-social="${card.dataset.for}"]`), card], () => {
          clearTimeout(hideTimer);
          const switching = openCard && openCard.card !== card;
          if (switching) openCard.close();
          show(switching ? fadeIn : { duration: 0.2 });
          return () => {
            hideTimer = setTimeout(() => hide({ duration: 0.2 }), 150);
          };
        });
      });
    </script>
  </body>
</html>
